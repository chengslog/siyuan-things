{
  "name": "siyuan-things",
  "version": "0.2.14",
  "type": "module",
  "description": "A GTD task management plugin inspired by Things for SiYuan Note",
  "repository": {
    "type": "git",
    "url": "https://github.com/chengslog/siyuan-things.git"
  },
  "homepage": "https://github.com/chengslog/siyuan-things",
  "author": "ccriss",
  "license": "MIT",
  "scripts": {
    "dev": "run-p dev:app dev:kernel",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "build": "run-s build:app build:kernel",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-link-win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/elevate.ps1 -scriptPath ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "version:patch": "node --no-warnings ./scripts/update_version.js patch",
    "version:minor": "node --no-warnings ./scripts/update_version.js minor",
    "version:major": "node --no-warnings ./scripts/update_version.js major",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.3.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.2.2",
    "svelte": "^4.2.20",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}